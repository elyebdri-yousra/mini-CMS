{{--
  A group of content within a page, such as a group of form fields, with
  an optional title and description. Stack several sections and they are
  separated by a divider.
--}}
@let(sectionTitle = $props.get('title'))
@let(sectionDescription = $props.get('description'))

<section class="[&+&]:mt-6 [&+&]:pt-6 [&+&]:border-t [&+&]:border-line">
  @if(sectionTitle || sectionDescription)
    <header>
      @if(sectionTitle)
        <h2 class="text-[15px] font-semibold tracking-[-0.01em]">{{ sectionTitle }}</h2>
      @end
      @if(sectionDescription)
        <p class="mt-0.5 text-muted text-[13.5px]">{{ sectionDescription }}</p>
      @end
    </header>
  @end

  <div class="flex flex-col gap-5 {{ sectionTitle || sectionDescription ? 'mt-[18px]' : '' }}">{{{ await $slots.main() }}}</div>
</section>

@let(variant = $props.get('variant') || 'success')
@inject({ variant, autoDismiss: $props.get('autoDismiss') })
@let(classes = `flex flex-row items-start gap-3 w-[400px] max-w-[calc(100%-32px)] bg-card border border-line-2 rounded-2xl shadow-[0_10px_30px_-12px_rgba(10,10,11,0.18)] px-[18px] py-4 pointer-events-auto transition`)

<div {{
  $props
    .except(['variant', 'autoDismiss'])
    .merge({
      role: 'alert',
      class: classes,
      'x-data': 'alert',
      'x-show': 'isVisible',
      'x-cloak': true,
    })
    .toAttrs()
}}>
  <span class="mt-px w-[18px] h-[18px] inline-flex items-center justify-center flex-none {{ variant === 'destructive' ? 'text-[var(--danger)]' : 'text-[var(--ok)]' }}">
    @if(variant === 'destructive')
      @svg('lucide:circle-alert', { width: 18, height: 18 })
    @else
      @svg('lucide:circle-check', { width: 18, height: 18 })
    @end
  </span>
  <div class="flex-1 flex flex-col gap-1 min-w-0">{{{ await $slots.main() }}}</div>
</div>

@let(currentTheme = request.plainCookie('app_theme', {
  defaultValue: 'light',
  encoded: false,
}))

<button
  type="button"
  class="relative inline-grid place-items-center w-9 h-9 rounded-lg border border-line text-muted transition hover:bg-card hover:text-ink hover:border-line-2 active:scale-[0.96]"
  data-initial-theme="{{ currentTheme }}"
  x-data="themeToggle"
  x-bind:aria-label="theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'"
  x-bind:title="theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'"
  x-on:click="toggle"
>
  @svg('lucide:sun', {
    width: 16,
    height: 16,
    class: 'themetoggle__icon themetoggle__icon--sun [grid-area:1/1]',
  })
  @svg('lucide:moon', {
    width: 16,
    height: 16,
    class: 'themetoggle__icon themetoggle__icon--moon [grid-area:1/1]',
  })
</button>

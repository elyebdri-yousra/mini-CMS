@let(classes = 'w-full min-h-[160px] px-3 py-2 bg-field border border-line-2 rounded-lg text-ink text-sm shadow-[0_1px_1px_rgba(10,10,11,0.03)] transition resize-y placeholder:text-subtle focus:outline-none focus:border-[var(--accent)] focus:ring-[3px] focus:ring-[var(--accent-ring)] aria-[invalid="true"]:border-[var(--danger)] data-[invalid="true"]:border-[var(--danger)]')

<textarea {{
  $props
    .except(['value'])
    .merge({
      name: $context.name,
      id: $context.id,
      class: classes,
      'aria-invalid': $context.hasErrors ? 'true' : false,
      'data-invalid': $context.hasErrors ? 'true' : false,
      'aria-describedby': $context.hasErrors ? `${$context.id}-error` : '',
    })
    .toAttrs()
}}>{{{ $context.oldValue || $props.get('value') || '' }}}</textarea>

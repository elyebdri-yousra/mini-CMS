{{--
  The frame for an app page: renders an optional heading and description,
  and optional actions (buttons, links) passed through the `actions` slot.
  The document title is set on the layout, for example
  @layouts.app({ title: 'Reports' }).
--}}
@let(pageTitle = $props.get('title'))
@let(pageDescription = $props.get('description'))

<div class="flex flex-col w-full max-w-[1080px] mx-auto px-[30px] pt-10 pb-16">
  @if(pageTitle || pageDescription || $slots.actions)
    <header class="flex flex-wrap items-end justify-between gap-y-4 gap-x-6 mb-7">
      <div>
        @if(pageTitle)
          <h1 class="text-2xl font-semibold tracking-[-0.02em] leading-[1.25]">{{ pageTitle }}</h1>
        @end
        @if(pageDescription)
          <p class="mt-1 text-muted text-[14.5px]">{{ pageDescription }}</p>
        @end
      </div>
      @if($slots.actions)
        <div class="flex gap-[10px]">{{{ await $slots.actions() }}}</div>
      @end
    </header>
  @end
  {{{ await $slots.main() }}}
</div>

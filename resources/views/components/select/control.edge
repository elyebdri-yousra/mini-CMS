@let(classes = 'w-full h-10 px-3 bg-field border border-line-2 rounded-lg text-ink text-sm shadow-[0_1px_1px_rgba(10,10,11,0.03)] transition focus:outline-none focus:border-[var(--accent)] focus:ring-[3px] focus:ring-[var(--accent-ring)] aria-[invalid="true"]:border-[var(--danger)] data-[invalid="true"]:border-[var(--danger)]')

<select {{
  $props
    .except(['options'])
    .merge({
      name: $context.name,
      id: $context.id,
      class: classes,
      'aria-invalid': $context.hasErrors ? 'true' : false,
      'data-invalid': $context.hasErrors ? 'true' : false,
      'aria-describedby': $context.hasErrors ? `${$context.id}-error` : '',
    })
    .toAttrs()
}}>
  @each(option in $props.get('options'))
    @let(isSelected = option.isSelected
      ? true
      : $context.oldValue && $context.oldValue === option.value)
    <option value="{{ option.value }}" {{ isSelected ? 'selected' : '' }}>
      {{ option.name ?? option.value }}
    </option>
  @end
</select>

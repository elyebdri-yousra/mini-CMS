<!DOCTYPE html>
<html
  lang="en-us"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'light',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AdonisJS — Starter Kit</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <header class="absolute inset-x-0 top-0 z-10 py-[22px]">
      <div class="max-w-[1100px] mx-auto px-[30px] flex items-center justify-between w-full">
        @!logo({ size: 28 })
        <div class="flex items-center gap-[10px]">
          @!themeToggle()
          @if(auth.user)
            @link({
              route: 'dashboard',
              class: 'inline-flex items-center justify-center gap-[7px] h-[34px] px-3 rounded-lg text-[13.5px] font-medium text-white transition hover:opacity-90',
              style: 'background:linear-gradient(135deg,var(--accent),var(--accent-2))',
            })
              Dashboard
            @end
          @else
            @link({
              route: 'session.create',
              class: 'inline-flex items-center justify-center gap-[7px] h-[34px] px-3 rounded-lg text-[13.5px] font-medium text-ink hover:text-muted transition',
            })
              Sign in
            @end
            @link({
              route: 'new_account.create',
              class: 'inline-flex items-center justify-center gap-[7px] h-[34px] px-3 rounded-lg text-[13.5px] font-medium text-white transition hover:opacity-90',
              style: 'background:linear-gradient(135deg,var(--accent),var(--accent-2))',
            })
              Get started
            @end
          @end
        </div>
      </div>
    </header>
    {{{ await $slots.main() }}}
    @include('partials/flash_alerts')
  </body>
</html>

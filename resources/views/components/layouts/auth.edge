<!DOCTYPE html>
<html
  lang="en-us"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'light',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AdonisJS — Starter Kit</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <div class="grid min-[880px]:grid-cols-[1.04fr_1fr] min-h-screen">
      <div class="flex flex-col px-9 py-[30px] relative bg-card">
        @!logo({ size: 28 })
        <div class="m-auto w-full max-w-[344px] py-5">{{{ await $slots.main() }}}</div>
        <div class="h-5"></div>
      </div>

      <aside class="hidden min-[880px]:flex relative border-l border-line bg-paper flex-col justify-between p-11">
        <div class="flex items-center justify-end">
          @!themeToggle()
        </div>

        <p class="font-serif font-normal text-[25px] leading-[1.3] tracking-[0.2px] text-balance max-w-[22ch]">Auth, kept intentionally minimal so you can build it your way.</p>

        <div>
          <div class="font-semibold text-[15px] mb-[5px] tracking-[-0.01em]">Looking for production-ready auth?</div>
          <p class="text-muted text-[13.5px] leading-[1.55] max-w-[36ch]">
            Check out Feature packs, production-ready full-stack components from the creator of AdonisJS.
          </p>
          <a
            class="text-ink underline decoration-[var(--line-2)] underline-offset-[3px] decoration-1 hover:decoration-[var(--ink)] transition-[text-decoration-color] mt-[14px] inline-block text-[13.5px] whitespace-nowrap"
            href="https://plus.adonisjs.com/feature-packs"
            target="_blank"
            rel="noreferrer"
          >
            Explore Feature packs →
          </a>
        </div>
      </aside>
    </div>
    @include('partials/flash_alerts')
  </body>
</html>

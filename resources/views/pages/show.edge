@layouts.marketing({ menuPages })
  <div class="min-h-screen px-6 pt-[140px] pb-20">
    <article class="max-w-[720px] mx-auto">
      @link({
        route: 'home',
        class: 'inline-flex items-center gap-1.5 text-muted hover:text-ink text-[13.5px] font-medium transition',
      })
        @svg('lucide:arrow-left', { width: 14, height: 14 })
        Retour aux pages
      @end

      <h1 class="text-gradient font-serif font-normal text-[32px] leading-[1.18] tracking-[0.2px] text-balance mt-5">{{ page.title }}</h1>
      @if(page.publishedAt)
        <p class="mt-2 text-muted text-[13px] font-mono">Publié le {{ page.publishedAt.toFormat('dd/MM/yyyy') }}</p>
      @end

      @if(page.content)
        <div class="mt-8 text-[15px] leading-[1.7] text-ink-2 whitespace-pre-line text-pretty">{{ page.content }}</div>
      @end
    </article>
  </div>
@end

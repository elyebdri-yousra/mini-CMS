@layouts.marketing({ menuPages })
  <div class="min-h-screen px-6 pt-[140px] pb-20">
    <div class="max-w-[760px] mx-auto">
      <div class="text-gradient font-serif font-normal text-[34px] leading-[1.12] tracking-[0.2px] text-balance">Mon mini CMS</div>
      <p class="mt-3 text-sm text-ink-2 leading-[1.6] text-pretty max-w-[50ch]">
        Les dernières pages publiées sur ce site.
      </p>

      @if(pages.length === 0)
        <div class="mt-16 text-center flex flex-col items-center gap-[13px]">
          <div class="w-[54px] h-[54px] rounded-lg border border-line-2 bg-card grid place-items-center text-subtle">
            @svg('lucide:file-text', { width: 22, height: 22 })
          </div>
          <h2 class="font-serif font-normal text-[22px] tracking-[0.2px] text-balance">Aucune page publiée pour le moment</h2>
          <p class="text-muted text-[14.5px] leading-[1.55] text-pretty max-w-[40ch]">
            Revenez bientôt, du contenu arrive.
          </p>
        </div>
      @else
        <ul class="mt-10 flex flex-col gap-4">
          @each(p in pages)
            <li>
              @link({
                route: 'pages.show',
                routeParams: { slug: p.slug },
                class: 'flex items-center gap-4 bg-card border border-line-2 rounded-[14px] px-6 py-5 transition hover:border-[var(--accent)]',
              })
                @if(p.cover)
                  <img src="{{ p.cover.path }}" alt="" class="w-16 h-16 rounded-lg object-cover flex-none" />
                @end
                <div class="min-w-0">
                  <div class="font-semibold text-[17px] tracking-[-0.01em]">{{ p.title }}</div>
                  @if(p.excerpt)
                    <p class="mt-1.5 text-muted text-[14px] leading-[1.55] text-pretty">{{ p.excerpt }}</p>
                  @end
                </div>
              @end
            </li>
          @end
        </ul>
      @end
    </div>
  </div>
@end

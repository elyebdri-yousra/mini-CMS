@layouts.marketing()
  <div class="min-h-screen flex flex-col items-center justify-center px-6 pt-[104px] pb-14">
    <article class="w-[580px] max-w-full bg-card border border-line-2 rounded-[14px] px-[46px] pt-[42px] pb-6 shadow-[0_1px_0_rgba(255,255,255,0.5)_inset,0_36px_70px_-46px_rgba(10,10,11,0.45)] [&>*]:animate-chunk-rise [&>*:nth-child(2)]:[animation-delay:0.1s] [&>*:nth-child(3)]:[animation-delay:0.2s] [&>*:nth-child(4)]:[animation-delay:0.3s] [&>*:nth-child(5)]:[animation-delay:0.4s] [&>*:nth-child(6)]:[animation-delay:0.5s]">
      <div class="flex items-center justify-between pb-[22px] border-b border-line">
        <span class="font-mono text-[11px] tracking-[0.09em] uppercase inline-flex items-center gap-2" style="color: var(--ok);">
          <span class="relative w-[7px] h-[7px] rounded-full border-[1.5px] border-current after:content-[''] after:absolute after:inset-[1.5px] after:rounded-full after:bg-current"></span>
          Server ready
        </span>
      </div>

      <div class="text-gradient font-serif font-normal text-[34px] leading-[1.12] tracking-[0.2px] text-balance flex flex-col mt-[26px]">Welcome to the power of a Hypermedia app.</div>

      <p class="mt-4 text-sm text-ink-2 leading-[1.6] text-pretty">
        A lightweight foundation for building modern web interfaces. Straightforward, flexible, and true to the web's core simplicity.
      </p>

      <p class="mt-4 text-sm text-ink-2 leading-[1.6] text-pretty">
        This page is simply proof the engine started. Everything from here is yours to build.
      </p>

      <ul class="list-none mt-[26px] flex flex-col">
        <li class="border-t border-line [&:last-child]:border-b">
          <a class="group flex items-center gap-3 py-[13px] px-0.5 transition-[padding] hover:pl-2" href="https://docs.adonisjs.com" target="_blank" rel="noreferrer">
            <span class="w-1.5 h-1.5 bg-ink rounded-[1px] flex-none"></span>
            <span class="font-semibold text-[15px] tracking-[-0.01em]">Documentation</span>
            <span class="text-muted text-[13.5px] whitespace-nowrap">Guides & API reference</span>
            <span class="ml-auto text-subtle inline-flex transition group-hover:text-ink group-hover:translate-x-[3px]">
              @svg('lucide:arrow-up-right', { width: 16, height: 16 })
            </span>
          </a>
        </li>
        <li class="border-t border-line [&:last-child]:border-b">
          <a class="group flex items-center gap-3 py-[13px] px-0.5 transition-[padding] hover:pl-2" href="https://plus.adonisjs.com" target="_blank" rel="noreferrer">
            <span class="w-1.5 h-1.5 bg-ink rounded-[1px] flex-none"></span>
            <span class="font-semibold text-[15px] tracking-[-0.01em]">AdonisJS Plus</span>
            <span class="text-muted text-[13.5px] whitespace-nowrap">Feature packs and Flow AI</span>
            <span class="ml-auto text-subtle inline-flex transition group-hover:text-ink group-hover:translate-x-[3px]">
              @svg('lucide:arrow-up-right', { width: 16, height: 16 })
            </span>
          </a>
        </li>
        <li class="border-t border-line [&:last-child]:border-b">
          <a class="group flex items-center gap-3 py-[13px] px-0.5 transition-[padding] hover:pl-2" href="https://discord.com/invite/vDcEjq6" target="_blank" rel="noreferrer">
            <span class="w-1.5 h-1.5 bg-ink rounded-[1px] flex-none"></span>
            <span class="font-semibold text-[15px] tracking-[-0.01em]">Discord</span>
            <span class="text-muted text-[13.5px] whitespace-nowrap">Meet fellow AdonisJS developers</span>
            <span class="ml-auto text-subtle inline-flex transition group-hover:text-ink group-hover:translate-x-[3px]">
              @svg('lucide:arrow-up-right', { width: 16, height: 16 })
            </span>
          </a>
        </li>
      </ul>

      <div class="flex items-center justify-between mt-[26px] pt-[18px] border-t border-line">
        <span class="font-mono text-[11px] tracking-[0.09em] uppercase text-subtle">Built with</span>
        <div class="group flex" role="list" aria-label="Tech stack">
          <span class="w-[34px] h-[34px] rounded-[9px] -ml-2 first:ml-0 grid place-items-center text-white font-semibold text-xs shadow-[0_0_0_3px_var(--card),0_2px_6px_rgba(0,0,0,0.18)] relative transition-[transform,margin] group-hover:ml-[3px] group-hover:first:ml-0" role="listitem" title="AdonisJS" style="background: #5A45FF;">
            <svg class="w-5 h-5 block" viewBox="0 0 160 160" fill="#fff" aria-hidden="true">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M0 80.0001C0 144.521 15.4786 160 79.9999 160 144.521 160 160 144.521 160 80.0001 160 15.4786 144.521 0 79.9999 0 15.4786 0 0 15.4786 0 80.0001zm32.2607 16.6191l25.0918-57.0266c4.2361-9.613 12.3825-14.8268 22.6474-14.8268 10.265 0 18.4113 5.2138 22.6481 14.8268l25.091 57.0266c1.141 2.77 2.118 6.3538 2.118 9.4498 0 14.175-9.939 24.114-24.114 24.114-4.828 0-8.6629-1.232-12.5444-2.479-3.9771-1.278-8.0036-2.572-13.1987-2.572-5.1349 0-9.2597 1.306-13.3154 2.589-3.9233 1.241-7.7814 2.462-12.4279 2.462-14.1752 0-24.1141-9.939-24.1141-24.114 0-3.096.9776-6.6798 2.1182-9.4498zm47.7392-47.0871L55.2344 105.581c7.332-3.422 15.8043-5.051 24.7655-5.051 8.6358 0 17.434 1.629 24.4401 5.051L79.9999 49.5321z"
              />
            </svg>
          </span>
          <span class="w-[34px] h-[34px] rounded-[9px] -ml-2 first:ml-0 grid place-items-center text-white font-semibold text-xs shadow-[0_0_0_3px_var(--card),0_2px_6px_rgba(0,0,0,0.18)] relative transition-[transform,margin] group-hover:ml-[3px] group-hover:first:ml-0" role="listitem" title="Edge" style="background: #4F46E5;">
            <svg class="w-5 h-5 block" viewBox="0 0 24 24" fill="#fff" aria-hidden="true">
              <path d="M6 4l6 16 6-16-3 0-3 9-3-9z" />
            </svg>
          </span>
          <span class="w-[34px] h-[34px] rounded-[9px] -ml-2 first:ml-0 grid place-items-center text-white font-semibold text-xs shadow-[0_0_0_3px_var(--card),0_2px_6px_rgba(0,0,0,0.18)] relative transition-[transform,margin] group-hover:ml-[3px] group-hover:first:ml-0" role="listitem" title="Alpine.js" style="background: #2D3748;">
            <svg class="w-5 h-5 block" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 7l6 6-6 6h6l6-6-6-6z" fill="#77C1D2" />
              <path d="M9 7l6 6-6 6h6l6-6-6-6z" fill="#2D3441" />
            </svg>
          </span>
          <span class="w-[34px] h-[34px] rounded-[9px] -ml-2 first:ml-0 grid place-items-center text-white font-semibold text-xs shadow-[0_0_0_3px_var(--card),0_2px_6px_rgba(0,0,0,0.18)] relative transition-[transform,margin] group-hover:ml-[3px] group-hover:first:ml-0" role="listitem" title="TypeScript" style="background: #3178C6;">
            <svg class="w-5 h-5 block" viewBox="0 0 24 24" aria-hidden="true">
              <text
                x="12"
                y="17"
                text-anchor="middle"
                font-family="ui-monospace, SFMono-Regular, Menlo, monospace"
                font-weight="700"
                font-size="10"
                fill="#fff"
                letter-spacing="-0.5"
              >
                TS
              </text>
            </svg>
          </span>
          <span class="w-[34px] h-[34px] rounded-[9px] -ml-2 first:ml-0 grid place-items-center text-white font-semibold text-xs shadow-[0_0_0_3px_var(--card),0_2px_6px_rgba(0,0,0,0.18)] relative transition-[transform,margin] group-hover:ml-[3px] group-hover:first:ml-0" role="listitem" title="Vite" style="background: #1E1B2E;">
            <svg class="w-5 h-5 block" viewBox="0 0 410 404" aria-hidden="true">
              <defs>
                <linearGradient
                  id="viteA"
                  x1="6"
                  y1="33"
                  x2="235"
                  y2="344"
                  gradientUnits="userSpaceOnUse"
                >
                  <stop stop-color="#41D1FF" />
                  <stop offset="1" stop-color="#BD34FE" />
                </linearGradient>
                <linearGradient
                  id="viteB"
                  x1="194"
                  y1="8"
                  x2="236"
                  y2="292"
                  gradientUnits="userSpaceOnUse"
                >
                  <stop stop-color="#FFEA83" />
                  <stop offset=".083" stop-color="#FFDD35" />
                  <stop offset="1" stop-color="#FFA800" />
                </linearGradient>
              </defs>
              <path
                d="M399.641 59.5246L215.643 388.545C211.844 395.338 202.084 395.378 198.228 388.618L10.5817 59.5563C6.38087 52.1896 12.6802 43.2665 21.0281 44.7586L205.223 77.6824C206.398 77.8924 207.601 77.8904 208.776 77.6763L389.119 44.8058C397.439 43.2894 403.768 52.1434 399.641 59.5246Z"
                fill="url(#viteA)"
              />
              <path
                d="M292.965 1.5744L156.801 28.2552C154.563 28.6937 152.906 30.5903 152.771 32.8664L144.395 174.33C144.198 177.662 147.258 180.248 150.51 179.498L188.42 170.749C191.967 169.931 195.172 173.055 194.443 176.622L183.18 231.775C182.422 235.487 185.907 238.661 189.532 237.56L212.947 230.446C216.577 229.344 220.065 232.527 219.297 236.242L201.398 322.875C200.278 328.294 207.486 331.249 210.492 326.603L212.5 323.5L323.454 102.072C325.312 98.3645 322.108 94.137 318.036 94.9233L279.014 102.452C275.347 103.159 272.227 99.7398 273.262 96.1457L298.731 7.66608C299.767 4.06956 296.642 0.649737 292.965 1.5744Z"
                fill="url(#viteB)"
              />
            </svg>
          </span>
        </div>
      </div>
    </article>
  </div>
@end

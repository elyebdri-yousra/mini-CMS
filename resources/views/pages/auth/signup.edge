@layouts.auth()
  <h1 class="text-gradient font-serif font-normal text-[27px] tracking-[0.2px] text-balance">Create your account</h1>
  <p class="text-muted text-sm mt-1">Start building with the starter kit.</p>
  @form({
    route: 'new_account.store',
    method: 'POST',
    class: 'flex flex-col gap-[15px] mt-[22px]',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'fullName' })
      @!field.label({ text: 'Full name' })
      @!input.control({ autocomplete: 'name', placeholder: 'Ada Lovelace' })
      @!field.error()
    @end
    @field.root({ name: 'email' })
      @!field.label({ text: 'Email' })
      @!input.control({
        type: 'email',
        autocomplete: 'email',
        placeholder: 'you@example.com',
      })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Password' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @field.root({ name: 'passwordConfirmation' })
      @!field.label({ text: 'Confirm password' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @!button({
      text: 'Create account',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'One moment…' : 'Create account'",
    })
  @end

  <p class="mt-[18px] text-center text-[13px] text-muted">

    Already have an account?

    @link({ route: 'session.create', class: 'text-ink underline decoration-[var(--line-2)] underline-offset-[3px] decoration-1 hover:decoration-[var(--ink)] transition-[text-decoration-color]' })
      Sign in
    @end
  </p>
@end

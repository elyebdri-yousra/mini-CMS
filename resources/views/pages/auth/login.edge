@layouts.auth()
  <h1 class="text-gradient font-serif font-normal text-[27px] tracking-[0.2px] text-balance">Bon retour</h1>
  <p class="text-muted text-sm mt-1">Connectez-vous à l'espace d'administration.</p>
  @form({
    route: 'session.store',
    method: 'POST',
    class: 'flex flex-col gap-[15px] mt-[22px]',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'email' })
      @!field.label({ text: 'Email' })
      @!input.control({
        type: 'email',
        autocomplete: 'username',
        placeholder: 'vous@exemple.com',
      })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Mot de passe' })
      @!input.control({
        type: 'password',
        autocomplete: 'current-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @!button({
      text: 'Se connecter',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Un instant…' : 'Se connecter'",
    })
  @end
@end

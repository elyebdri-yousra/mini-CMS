@layouts.auth()
  <h1 class="text-gradient font-serif font-normal text-[27px] tracking-[0.2px] text-balance">Welcome back</h1>
  <p class="text-muted text-sm mt-1">Sign in to continue building.</p>
  @form({
    route: 'session.store',
    method: 'POST',
    class: 'flex flex-col gap-[15px] mt-[22px]',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'email' })
      @!field.label({ text: 'Email' })
      @!input.control({
        type: 'email',
        autocomplete: 'username',
        placeholder: 'you@example.com',
      })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Password' })
      @!input.control({
        type: 'password',
        autocomplete: 'current-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @!button({
      text: 'Sign in',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'One moment…' : 'Sign in'",
    })
  @end

  <p class="mt-[18px] text-center text-[13px] text-muted">


    New here?


    @link({ route: 'new_account.create', class: 'text-ink underline decoration-[var(--line-2)] underline-offset-[3px] decoration-1 hover:decoration-[var(--ink)] transition-[text-decoration-color]' })
      Create an account
    @end
  </p>
@end

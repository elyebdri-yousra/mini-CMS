@layouts.app({ title: 'Utilisateurs' })
  @page({ title: 'Utilisateurs', description: 'Gérez les comptes administrateurs et éditeurs.' })
    @slot('actions')
      @link({
        route: 'admin_users.create',
        class: 'inline-flex items-center justify-center gap-[7px] h-[38px] px-[15px] rounded-lg text-sm font-medium text-white transition hover:opacity-90',
        style: 'background:linear-gradient(135deg,var(--accent),var(--accent-2))',
      })
        @svg('lucide:plus', { width: 15, height: 15 })
        Nouvel utilisateur
      @end
    @end

    <div class="bg-card border border-line-2 rounded-[14px] overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-line text-left text-muted text-[12.5px] uppercase tracking-wide">
            <th class="px-4 py-3 font-medium">Nom</th>
            <th class="px-4 py-3 font-medium">Email</th>
            <th class="px-4 py-3 font-medium">Rôle</th>
            <th class="px-4 py-3 font-medium text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          @each(u in users)
            <tr class="border-b border-line last:border-b-0">
              <td class="px-4 py-3 font-medium text-ink">{{ u.fullName ?? '—' }}</td>
              <td class="px-4 py-3 text-muted">{{ u.email }}</td>
              <td class="px-4 py-3">
                @if(u.role === 'admin')
                  <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[12px] font-medium bg-[color-mix(in_oklab,var(--accent)_15%,transparent)] text-[var(--accent)]">Administrateur</span>
                @else
                  <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[12px] font-medium bg-[color-mix(in_oklab,var(--muted)_15%,transparent)] text-muted">Éditeur</span>
                @end
              </td>
              <td class="px-4 py-3">
                <div class="flex items-center justify-end gap-1.5">
                  @link({
                    route: 'admin_users.edit',
                    routeParams: { id: u.id },
                    class: 'relative inline-grid place-items-center w-8 h-8 rounded-lg border border-line text-muted transition hover:bg-paper hover:text-ink hover:border-line-2',
                    title: 'Modifier',
                  })
                    @svg('lucide:pencil', { width: 15, height: 15 })
                  @end

                  @if(u.id !== auth.user.id)
                    @form({
                      route: 'admin_users.destroy',
                      routeParams: { id: u.id },
                      method: 'DELETE',
                      'x-data': '{}',
                      'x-on:submit': "confirm('Supprimer définitivement ce compte ?') || $event.preventDefault()",
                    })
                      <button
                        type="submit"
                        class="relative inline-grid place-items-center w-8 h-8 rounded-lg border border-line text-muted transition hover:bg-paper hover:text-[var(--danger)] hover:border-line-2"
                        title="Supprimer"
                      >
                        @svg('lucide:trash-2', { width: 15, height: 15 })
                      </button>
                    @end
                  @end
                </div>
              </td>
            </tr>
          @end
        </tbody>
      </table>
    </div>
  @end
@end

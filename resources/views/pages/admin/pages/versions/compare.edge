@layouts.app({ title: `Comparer · ${page.title}` })
  @page({ title: 'Comparer deux versions', description: page.title })
    @slot('actions')
      @link({
        route: 'admin_page_versions.index',
        routeParams: { pageId: page.id },
        class: 'inline-flex items-center justify-center gap-[7px] h-[38px] px-[15px] rounded-lg border border-line-2 bg-card text-ink text-sm font-medium hover:bg-paper transition',
      })
        Retour à l'historique
      @end
    @end

    @if(!diff)
      <p class="text-muted text-[14px]">Choisis deux versions à comparer depuis l'historique.</p>
    @else
      <div class="flex flex-wrap gap-x-6 gap-y-1 mb-5 text-[13px] text-muted">
        <div><span class="font-medium text-ink">Version A</span> — {{ from.createdAt.toFormat('dd/MM/yyyy HH:mm') }} ({{ from.user ? (from.user.fullName ?? from.user.email) : 'utilisateur supprimé' }})</div>
        <div><span class="font-medium text-ink">Version B</span> — {{ to.createdAt.toFormat('dd/MM/yyyy HH:mm') }} ({{ to.user ? (to.user.fullName ?? to.user.email) : 'utilisateur supprimé' }})</div>
      </div>

      @if(from.title !== to.title)
        <p class="text-[13px] mb-1.5"><span class="text-muted">Titre :</span> <span class="line-through text-[var(--danger)]">{{ from.title }}</span> → <span class="text-[var(--accent)]">{{ to.title }}</span></p>
      @end
      @if(from.status !== to.status)
        <p class="text-[13px] mb-4"><span class="text-muted">Statut :</span> <span class="line-through text-[var(--danger)]">{{ from.status === 'published' ? 'Publié' : 'Brouillon' }}</span> → <span class="text-[var(--accent)]">{{ to.status === 'published' ? 'Publié' : 'Brouillon' }}</span></p>
      @end

      <div class="text-[13px] font-medium text-ink mb-2">Contenu</div>
      <pre class="bg-card border border-line-2 rounded-[14px] p-4 text-[13px] leading-[1.6] whitespace-pre-wrap font-mono overflow-x-auto">
@each(part in diff)
<span class="{{ part.cls }}">{{ part.value }}</span>
@end
</pre>
    @end
  @end
@end

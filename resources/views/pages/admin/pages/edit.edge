@layouts.app({ title: `Modifier · ${page.title}` })
  @page({ title: 'Modifier la page', description: page.title })
    @form({
      route: 'admin_pages.update',
      routeParams: { id: page.id },
      method: 'PUT',
      class: 'flex flex-col gap-6 max-w-2xl',
    })
      <div class="flex flex-col gap-5">
        @include('pages/admin/pages/_form')
      </div>
      <div class="flex gap-3">
        @!button({ text: 'Enregistrer', type: 'submit' })
        @link({
          route: 'admin_pages.index',
          class: 'inline-flex items-center justify-center gap-[7px] h-[38px] px-[15px] rounded-lg border border-line-2 bg-card text-ink text-sm font-medium hover:bg-paper transition',
        })
          Annuler
        @end
      </div>
    @end
  @end
@end
